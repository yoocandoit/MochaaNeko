@import "~/.config/rofi/wallust/mocha.rasi"

configuration {
    modi: "drun";
    font: "Google Sans Flex Regular 11";
    show-icons: true;
    display-drun: "";
    icon-theme: "Colloid";
    sidebar-mode: false;
    drun-display-format: "{name}";
    hover-select: true;
}

* {
    bg: rgba(30,30,46,0.60);
    fg: @on-surface;
    accent: @primary;
    button: @surface-container;

    background-color: transparent;
    text-color: @fg;
}

window {
    enabled: true;
    fullscreen: false;
    transparency: "real";
    cursor: "default";

    border: 2px;
    border-radius: 16px;
    border-color: @outline;

    width: 40%;
    padding: 8px;

    background-color: @bg;
}

mainbox {
    enabled: true;
    orientation: vertical;

    children: [
        inputbar,
        listview
    ];

    spacing: 10px;
    padding: 8px;

    background-color: transparent;
}

inputbar {
    enabled: true;

    children: [
        prompt,
        entry
    ];

    expand: false;
    margin: 0px;
    padding: 10px;

    border-radius: 10px;

    background-color: @button;
}

prompt {
    enabled: false;

    background-color: transparent;
    text-color: @on-surface;
}

entry {
    enabled: true;
    expand: true;

    placeholder: "Search";
    placeholder-color: @on-surface-variant;

    background-color: transparent;
    text-color: @on-surface;

    padding: 4px;
}

listview {
    enabled: true;

    columns: 4;
    lines: 3;

    cycle: false;
    dynamic: true;
    layout: vertical;

    spacing: 6px;
    padding: 2px;

    scrollbar: false;

    background-color: transparent;
    border: 0px;
}

scrollbar {
    enabled: false;

    background-color: transparent;
    handle-color: @primary;
    handle-width: 2px;
}

/* =========================
   WALLPAPER ELEMENT
   ========================= */

element {
    enabled: true;

    orientation: vertical;

    spacing: 4px;
    padding: 8px;

    border-radius: 10px;

    background-color: transparent;
    text-color: @on-surface;

    cursor: pointer;
}

/* NORMAL */

element normal.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element normal.urgent {
    background-color: transparent;
    text-color: @on-surface;
}

element normal.active {
    background-color: @primary;
    text-color: @on-primary;
}

/* SELECTED / HOVER */

element selected {
    background-color: @primary;
    text-color: @on-primary;

    border-radius: 10px;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;

    border-radius: 10px;
}

element selected.active {
    background-color: @primary;
    text-color: @on-primary;

    border-radius: 10px;
}

element selected.urgent {
    background-color: @primary;
    text-color: @on-primary;

    border-radius: 10px;
}

/* =========================
   ICON
   ========================= */

element-icon {
    enabled: true;

    size: 48px;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    background-color: transparent;
    text-color: inherit;

    cursor: inherit;
}

/* =========================
   TEXT
   ========================= */

element-text {
    enabled: true;
    expand: true;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    margin: 2px 0px 0px 0px;

    background-color: transparent;
    text-color: inherit;

    cursor: inherit;
}
